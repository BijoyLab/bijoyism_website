# Server-only. Copy to .env.local. Mail stays disabled until deliberately configured.
RESEND_API_KEY=
INQUIRY_MAIL_ENABLED=false
INQUIRY_MAIL_FROM=BIJOYISM <support@bijoyism.cn>
INQUIRY_ALLOWED_ORIGINS=https://bijoyism.cc,https://bijoyism.cn,http://127.0.0.1:3101,http://127.0.0.1:3100
# Cookie-free purchase-click records in hosting logs. Enable after log retention is configured.
PURCHASE_ANALYTICS_ENABLED=false
